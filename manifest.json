{
  "name": "NUWorks Co-op Extension",
  "description": "Extension to help Northeastern students find co-op opportunities",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["https://northeastern-csm.symplicity.com/*"],
  "background": {
    "service_worker": "background.js"
  }
}
