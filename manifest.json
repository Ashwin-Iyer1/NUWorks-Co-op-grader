{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  },
  "permissions": [
    "activeTab",
    "webRequest",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://northeastern-csm.symplicity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
