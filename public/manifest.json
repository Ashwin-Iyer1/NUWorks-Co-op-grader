{
  "name": "Northeastern Co-op Screener",
  "description": "Extension to help Northeastern students find co-op opportunities on NUWorks.",
  "version": "1.1",
  "manifest_version": 3,
  "icons": {
    "16": "extension_icon16.png",
    "32": "extension_icon32.png",
    "48": "extension_icon48.png",
    "128": "extension_icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "extension_icon16.png",
      "32": "extension_icon32.png",
      "48": "extension_icon48.png",
      "128": "extension_icon128.png"
    }
  },
  "permissions": ["webRequest", "storage", "scripting"],
  "host_permissions": ["https://northeastern-csm.symplicity.com/*"],
  "content_scripts": [
    {
      "matches": ["https://northeastern-csm.symplicity.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://northeastern-csm.symplicity.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
